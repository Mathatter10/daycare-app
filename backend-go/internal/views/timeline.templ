package views

import (
	"strconv"
	"time"
)

// TimelineReport is one child's day for the admin; times are in the daycare
// time zone.
type TimelineReport struct {
	ChildID      string
	ChildName    string
	Nickname     string
	ClassName    string
	DateOfBirth  time.Time
	Allergies    string
	MedicalNotes string
	ParentName   string
	ParentPhone  string
	Inactive     bool

	Date     time.Time
	PrevDate string
	NextDate string // empty when Date is today (no future days)
	Today    string // YYYY-MM-DD in the daycare time zone

	Entries          []TimelineEntry // chronological
	AttendanceNote   string
	ActivityCount    int
	DeletedCount     int
	MediaCount       int
	MediaUnavailable bool // storage not configured: photos cannot be shown

	GeneratedAt time.Time
	GeneratedBy string
}

// TimelineEntry is one line of the chronology.
type TimelineEntry struct {
	At          time.Time
	Kind        string // checkin | checkout | activity | media
	Title       string
	Description string
	By          string
	Deleted     bool
	Audit       []string // late entry, edits, deletion
	URL         string   // media only
	ThumbURL    string
}

func (r TimelineReport) attended() bool {
	for _, e := range r.Entries {
		if e.Kind == "checkin" {
			return true
		}
	}
	return false
}

func (r TimelineReport) url(date string) string {
	return "/admin/children/" + r.ChildID + "/timeline?date=" + date
}

var weekdays = [...]string{"Minggu", "Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu"}
var monthLong = [...]string{"Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"}

// longDate formats like "Rabu, 21 Oktober 2026".
func longDate(t time.Time) string {
	return weekdays[t.Weekday()] + ", " + strconv.Itoa(t.Day()) + " " + monthLong[t.Month()-1] + " " + strconv.Itoa(t.Year())
}

templ ChildTimelinePage(p Page, r TimelineReport) {
	@AdminLayout(p) {
		<div class="mb-4 flex flex-wrap items-center justify-between gap-3 print:hidden">
			<a href="/admin/children" class="text-sm font-semibold text-brand hover:underline">← Daftar anak</a>
			<button type="button" onclick="window.print()" class="rounded-lg bg-brand px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand/90">
				Cetak / simpan PDF
			</button>
		</div>
		<div id="timeline">
			@TimelineBody(r)
		</div>
	}
}

// TimelineBody is swapped on its own when the date changes.
templ TimelineBody(r TimelineReport) {
	<div class="mb-4 flex flex-wrap items-center gap-2 print:hidden">
		@dayNavButton("‹ Sebelumnya", r.url(r.PrevDate))
		<input
			type="date"
			name="date"
			value={ r.Date.Format("2006-01-02") }
			max={ r.Today }
			hx-get={ "/admin/children/" + r.ChildID + "/timeline" }
			hx-trigger="change"
			hx-target="#timeline"
			hx-push-url="true"
			class="rounded-lg border border-gray-300 px-3 py-2 text-sm"
			aria-label="Tanggal"
		/>
		if r.NextDate != "" {
			@dayNavButton("Berikutnya ›", r.url(r.NextDate))
		}
	</div>
	<article class="rounded-lg bg-white p-5 shadow-card print:p-0 print:shadow-none">
		<header class="border-b border-gray-200 pb-4">
			<p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Laporan harian anak</p>
			<h1 class="mt-1 text-2xl font-bold">
				{ r.ChildName }
				if r.Nickname != "" {
					<span class="font-normal text-gray-500">({ r.Nickname })</span>
				}
				if r.Inactive {
					<span class="ml-2 align-middle">
						@StatusBadge(false)
					</span>
				}
			</h1>
			<p class="mt-1 text-lg font-semibold text-brand">{ longDate(r.Date) }</p>
			<dl class="mt-3 grid grid-cols-1 gap-x-6 gap-y-1 text-sm sm:grid-cols-2">
				@reportField("Kelas", orDash(r.ClassName))
				@reportField("Usia", ageLabel(r.DateOfBirth))
				@reportField("Orang tua", r.ParentName+phoneSuffix(r.ParentPhone))
				if r.Allergies != "" {
					<div class="flex gap-2">
						<dt class="w-28 shrink-0 text-gray-500">Alergi</dt>
						<dd class="font-semibold text-alert">⚠ { r.Allergies }</dd>
					</div>
				}
				if r.MedicalNotes != "" {
					@reportField("Catatan medis", r.MedicalNotes)
				}
			</dl>
		</header>
		<div class="flex flex-wrap gap-2 py-4 text-xs font-semibold">
			if r.attended() {
				<span class="rounded-full bg-accent/10 px-3 py-1 text-accent">Hadir</span>
			} else {
				<span class="rounded-full bg-gray-200 px-3 py-1 text-gray-600">Tidak ada check-in</span>
			}
			<span class="rounded-full bg-brand/10 px-3 py-1 text-brand">{ strconv.Itoa(r.ActivityCount) } aktivitas</span>
			if r.DeletedCount > 0 {
				<span class="rounded-full bg-red-50 px-3 py-1 text-alert">{ strconv.Itoa(r.DeletedCount) } dihapus</span>
			}
			if r.MediaUnavailable {
				<span class="rounded-full bg-gray-200 px-3 py-1 text-gray-600">Foto tidak tersedia (penyimpanan belum diatur)</span>
			} else {
				<span class="rounded-full bg-gray-100 px-3 py-1 text-gray-600">{ strconv.Itoa(r.MediaCount) } foto/video</span>
			}
		</div>
		if len(r.Entries) == 0 {
			<p class="py-10 text-center text-gray-400">Tidak ada catatan pada tanggal ini.</p>
		} else {
			<div class="overflow-x-auto">
				<table class="min-w-full text-left text-sm">
					<thead class="border-b border-gray-200 text-xs uppercase tracking-wide text-gray-500">
						<tr>
							<th class="px-3 py-2 font-semibold">Jam</th>
							<th class="px-3 py-2 font-semibold">Kejadian</th>
							<th class="px-3 py-2 font-semibold">Dicatat oleh</th>
							<th class="px-3 py-2 font-semibold">Keterangan sistem</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-gray-100">
						for _, e := range r.Entries {
							@timelineRow(e)
						}
					</tbody>
				</table>
			</div>
		}
		if r.AttendanceNote != "" {
			<p class="mt-4 text-sm"><span class="text-gray-500">Catatan absensi:</span> { r.AttendanceNote }</p>
		}
		<footer class="mt-6 border-t border-gray-200 pt-3 text-xs text-gray-500">
			Dibuat dari sistem { DateTimeLabel(r.GeneratedAt) } oleh { r.GeneratedBy }. Jam sesuai zona waktu daycare.
			Aktivitas yang dihapus tetap ditampilkan (dicoret) agar laporan lengkap.
		</footer>
		<div class="mt-12 hidden grid-cols-2 gap-12 text-center text-sm print:grid">
			<div>Dibuat oleh<div class="mt-16 border-t border-gray-400 pt-1">( nama &amp; tanda tangan )</div></div>
			<div>Mengetahui<div class="mt-16 border-t border-gray-400 pt-1">( nama &amp; tanda tangan )</div></div>
		</div>
	</article>
}

templ dayNavButton(label, href string) {
	<a
		href={ templ.SafeURL(href) }
		hx-get={ href }
		hx-target="#timeline"
		hx-push-url="true"
		class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50"
	>
		{ label }
	</a>
}

templ reportField(label, value string) {
	<div class="flex gap-2">
		<dt class="w-28 shrink-0 text-gray-500">{ label }</dt>
		<dd>{ value }</dd>
	</div>
}

templ timelineRow(e TimelineEntry) {
	<tr class={ "break-inside-avoid align-top", templ.KV("bg-red-50", e.Deleted) }>
		<td class="whitespace-nowrap px-3 py-2 font-semibold">{ e.At.Format("15:04") }</td>
		<td class="px-3 py-2">
			<p class={ "font-semibold", templ.KV("text-gray-500 line-through", e.Deleted) }>{ e.Title }</p>
			if e.Description != "" {
				<p class={ "text-gray-600", templ.KV("line-through", e.Deleted) }>{ e.Description }</p>
			}
			if e.ThumbURL != "" {
				<a href={ templ.SafeURL(e.URL) } target="_blank" rel="noopener" class="mt-1 inline-block">
					<img src={ e.ThumbURL } alt={ e.Title } class="h-24 w-24 rounded-md object-cover" loading="lazy"/>
				</a>
			}
		</td>
		<td class="whitespace-nowrap px-3 py-2">{ orDash(e.By) }</td>
		<td class="px-3 py-2 text-xs">
			for _, a := range e.Audit {
				<p class={ templ.KV("font-semibold text-alert", e.Deleted), templ.KV("text-gray-500", !e.Deleted) }>{ a }</p>
			}
		</td>
	</tr>
}

func orDash(s string) string {
	if s == "" {
		return "—"
	}
	return s
}

func phoneSuffix(phone string) string {
	if phone == "" {
		return ""
	}
	return " · " + phone
}
