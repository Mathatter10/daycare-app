package views

import "github.com/Mathatter10/daycare-app/backend-go/internal/repository"

type ChildFilter struct {
	Search          string
	ClassID         string
	IncludeInactive bool
}

type ChildForm struct {
	ID               string // empty when creating
	FullName         string
	Nickname         string
	DateOfBirth      string // yyyy-mm-dd
	Gender           string
	ClassID          string
	ParentEmail      string
	Allergies        string
	MedicalNotes     string
	EmergencyContact string
	Errors           FormErrors
}

templ ChildrenPage(p Page, rows []repository.ListChildrenRow, f ChildFilter, classes []Option) {
	@AdminLayout(p) {
		@PageHeader("Anak", "Profil anak, kelas, dan orang tua yang terhubung.") {
			@AddButton("/admin/children/new", "Tambah anak")
		}
		<form
			hx-get="/admin/children"
			hx-trigger="input delay:300ms, change"
			hx-target="#child-rows"
			hx-push-url="true"
			class="mb-3 flex flex-wrap items-center gap-3"
		>
			<input
				type="search"
				name="q"
				value={ f.Search }
				placeholder="Cari nama anak atau orang tua…"
				class="w-full max-w-xs rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-brand focus:ring-2 focus:ring-brand/30 focus:outline-none"
			/>
			<select name="class_id" class="rounded-lg border border-gray-300 px-3 py-2 text-sm">
				<option value="">Semua kelas</option>
				for _, o := range classes {
					<option value={ o.Value } selected?={ o.Value == f.ClassID }>{ o.Label }</option>
				}
			</select>
			<label class="flex items-center gap-2 text-sm text-gray-600">
				<input type="checkbox" name="inactive" value="1" checked?={ f.IncludeInactive } class="h-4 w-4 accent-brand"/>
				Tampilkan nonaktif
			</label>
		</form>
		@Table([]string{"Nama", "Umur", "Kelas", "Orang tua", "Status", ""}, "child-rows") {
			@ChildRows(rows)
		}
	}
}

templ ChildRows(rows []repository.ListChildrenRow) {
	for _, r := range rows {
		@ChildRow(r, false)
	}
	@EmptyRow(6, "Tidak ada data anak.")
}

templ ChildRow(r repository.ListChildrenRow, oob bool) {
	<tr
		id={ "child-" + r.ID.String() }
		class={ templ.KV("opacity-60", !r.IsActive) }
		if oob {
			hx-swap-oob="true"
		}
	>
		<td class="px-4 py-3">
			<p class="font-semibold">
				{ r.FullName }
				if text(r.Nickname) != "" {
					<span class="font-normal text-gray-500">({ text(r.Nickname) })</span>
				}
			</p>
			if text(r.Allergies) != "" {
				<p class="mt-0.5 text-xs font-semibold text-alert">⚠ Alergi: { text(r.Allergies) }</p>
			}
		</td>
		<td class="whitespace-nowrap px-4 py-3">
			{ ageLabel(r.DateOfBirth) }
			<p class="text-xs text-gray-500">{ genderLabel(r.Gender) }</p>
		</td>
		<td class="px-4 py-3">
			if r.ClassName == "" {
				<span class="text-gray-400">Tanpa kelas</span>
			} else {
				{ r.ClassName }
			}
		</td>
		<td class="px-4 py-3">
			<p>{ r.ParentName }</p>
			<p class="text-xs text-gray-500">{ r.ParentEmail }</p>
		</td>
		<td class="px-4 py-3">
			@StatusBadge(r.IsActive)
		</td>
		<td class="whitespace-nowrap px-4 py-3 text-right">
			<a href={ templ.SafeURL("/admin/children/" + r.ID.String() + "/timeline") } class="rounded-md px-2 py-1 text-xs font-semibold text-brand hover:bg-brand/10">Timeline</a>
			@RowButton("Ubah", false, templ.Attributes{"hx-get": "/admin/children/" + r.ID.String() + "/edit", "hx-target": "#modal"})
			if r.IsActive {
				@RowButton("Nonaktifkan", true, templ.Attributes{"hx-post": "/admin/children/" + r.ID.String() + "/active", "hx-vals": `{"active":"false"}`, "hx-confirm": "Nonaktifkan " + r.FullName + "? Data dan riwayatnya tetap tersimpan.", "hx-target": "closest tr", "hx-swap": "outerHTML"})
			} else {
				@RowButton("Aktifkan", false, templ.Attributes{"hx-post": "/admin/children/" + r.ID.String() + "/active", "hx-vals": `{"active":"true"}`, "hx-target": "closest tr", "hx-swap": "outerHTML"})
			}
		</td>
	</tr>
}

templ ChildFormModal(f ChildForm, classes []Option, parents []repository.ListUserOptionsRow) {
	@Modal(childFormTitle(f)) {
		<form
			if f.ID == "" {
				hx-post="/admin/children"
			} else {
				hx-post={ "/admin/children/" + f.ID }
			}
			hx-target="#modal"
			hx-disabled-elt="find button[type=submit]"
			class="space-y-4"
		>
			@FormError(f.Errors)
			<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
				@TextField("Nama lengkap", "full_name", "text", f.FullName, true, f.Errors, templ.Attributes{"maxlength": "100"})
				@TextField("Nama panggilan", "nickname", "text", f.Nickname, false, f.Errors, templ.Attributes{"maxlength": "50"})
				@TextField("Tanggal lahir", "date_of_birth", "date", f.DateOfBirth, true, f.Errors, nil)
				@SelectField("Jenis kelamin", "gender", []Option{{"", "-"}, {"male", "Laki-laki"}, {"female", "Perempuan"}}, f.Gender, f.Errors)
			</div>
			@SelectField("Kelas", "class_id", append([]Option{{"", "Tanpa kelas"}}, classes...), f.ClassID, f.Errors)
			<div>
				@TextField("Email orang tua", "parent_email", "email", f.ParentEmail, true, f.Errors, templ.Attributes{"list": "parent-options", "autocomplete": "off"})
				<datalist id="parent-options">
					for _, p := range parents {
						<option value={ p.Email }>{ p.FullName }</option>
					}
				</datalist>
				<p class="mt-1 text-xs text-gray-500">Akun orang tua harus sudah dibuat di menu Orang Tua.</p>
			</div>
			@TextArea("Alergi", "allergies", f.Allergies, f.Errors)
			@TextArea("Catatan medis", "medical_notes", f.MedicalNotes, f.Errors)
			@TextField("Kontak darurat", "emergency_contact", "text", f.EmergencyContact, false, f.Errors, templ.Attributes{"maxlength": "200", "placeholder": "Nama - No. HP"})
			@FormActions("Simpan")
		</form>
	}
}

func childFormTitle(f ChildForm) string {
	if f.ID == "" {
		return "Tambah anak"
	}
	return "Ubah data anak"
}
