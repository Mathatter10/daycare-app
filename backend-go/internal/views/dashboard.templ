package views

import (
	"strconv"

	"github.com/Mathatter10/daycare-app/backend-go/internal/repository"
)

templ DashboardPage(p Page, counts repository.DashboardCountsRow) {
	@AdminLayout(p) {
		@PageHeader("Selamat datang, "+p.AdminName, "Ringkasan data daycare.")
		<div class="grid grid-cols-2 gap-4 md:grid-cols-4">
			@statTile("/admin/children", "Anak aktif", counts.Children)
			@statTile("/admin/classes", "Kelas", counts.Classes)
			@statTile("/admin/caregivers", "Pengasuh aktif", counts.Caregivers)
			@statTile("/admin/parents", "Orang tua aktif", counts.Parents)
		</div>
	}
}

templ statTile(href, label string, value int32) {
	<a href={ templ.SafeURL(href) } class="rounded-lg bg-white p-5 shadow-card hover:ring-2 hover:ring-brand/30">
		<p class="text-sm text-gray-500">{ label }</p>
		<p class="mt-1 text-3xl font-bold">{ strconv.Itoa(int(value)) }</p>
	</a>
}
