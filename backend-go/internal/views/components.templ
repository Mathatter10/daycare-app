package views

const inputClass = "mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-brand focus:ring-2 focus:ring-brand/30 focus:outline-none"

templ PageHeader(title, subtitle string) {
	<div class="mb-4 flex flex-wrap items-end justify-between gap-3">
		<div>
			<h1 class="text-2xl font-bold">{ title }</h1>
			<p class="mt-1 text-sm text-gray-500">{ subtitle }</p>
		</div>
		{ children... }
	</div>
}

templ AddButton(url, label string) {
	<button
		hx-get={ url }
		hx-target="#modal"
		class="rounded-lg bg-accent px-4 py-2.5 text-sm font-semibold text-white hover:bg-accent/90"
	>
		+ { label }
	</button>
}

// Table renders a card with a scrollable body and sticky header. Rows go in
// the tbody with the given id, so HTMX can swap or prepend them.
templ Table(headers []string, bodyID string) {
	<div class="max-h-[70vh] overflow-auto rounded-lg bg-white shadow-card">
		<table class="min-w-full text-left text-sm">
			<thead class="sticky top-0 z-10 bg-gray-100 text-xs uppercase tracking-wide text-gray-500">
				<tr>
					for _, h := range headers {
						<th class="whitespace-nowrap px-4 py-3 font-semibold">{ h }</th>
					}
				</tr>
			</thead>
			<tbody id={ bodyID } class="divide-y divide-gray-100">
				{ children... }
			</tbody>
		</table>
	</div>
}

// EmptyRow goes last in a tbody and is only visible when it is the only row,
// so inserting or deleting rows needs no extra bookkeeping.
templ EmptyRow(cols int, msg string) {
	<tr class="hidden only:table-row">
		<td colspan={ cols } class="px-4 py-10 text-center text-gray-400">{ msg }</td>
	</tr>
}

templ StatusBadge(active bool) {
	if active {
		<span class="rounded-full bg-accent/10 px-2 py-0.5 text-xs font-semibold text-accent">Aktif</span>
	} else {
		<span class="rounded-full bg-gray-200 px-2 py-0.5 text-xs font-semibold text-gray-500">Nonaktif</span>
	}
}

templ RowButton(label string, danger bool, attrs templ.Attributes) {
	<button
		class={ "rounded-md px-2 py-1 text-xs font-semibold",
			templ.KV("text-brand hover:bg-brand/10", !danger),
			templ.KV("text-alert hover:bg-alert/10", danger) }
		{ attrs... }
	>
		{ label }
	</button>
}

// OOBInsert prepends a row to a table body from a response whose main
// content goes elsewhere. <template> lets a bare <tbody>/<tr> survive parsing.
templ OOBInsert(bodyID string, row templ.Component) {
	<template>
		<tbody hx-swap-oob={ "afterbegin:#" + bodyID }>
			@row
		</tbody>
	</template>
}

// OOBReplace swaps an existing row; the row must render hx-swap-oob="true".
templ OOBReplace(row templ.Component) {
	<template>
		@row
	</template>
}

templ Modal(title string) {
	<div class="fixed inset-0 z-40 flex items-start justify-center overflow-y-auto bg-black/50 p-4 sm:items-center" role="dialog" aria-modal="true">
		<div class="w-full max-w-lg rounded-lg bg-white shadow-card">
			<div class="flex items-center justify-between border-b border-gray-100 px-5 py-4">
				<h2 class="text-lg font-semibold">{ title }</h2>
				<button type="button" onclick="closeModal()" class="rounded p-1 text-gray-400 hover:text-gray-600" aria-label="Tutup">✕</button>
			</div>
			<div class="px-5 py-4">
				{ children... }
			</div>
		</div>
	</div>
}

templ FormActions(submitLabel string) {
	<div class="flex justify-end gap-2 pt-2">
		<button type="button" onclick="closeModal()" class="rounded-lg px-4 py-2.5 text-sm font-semibold text-gray-600 hover:bg-gray-100">Batal</button>
		<button type="submit" class="rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-white hover:bg-accent/90 disabled:opacity-60">{ submitLabel }</button>
	</div>
}

templ FormError(errs FormErrors) {
	if msg, ok := errs["_form"]; ok {
		<p class="rounded-lg bg-red-50 px-3 py-2 text-sm text-alert">{ msg }</p>
	}
}

templ fieldLabel(name, label string, required bool) {
	<label for={ name } class="block text-sm font-semibold">
		{ label }
		if required {
			<span class="text-alert">*</span>
		}
	</label>
}

templ fieldError(msg string) {
	if msg != "" {
		<p class="mt-1 text-xs text-alert">{ msg }</p>
	}
}

templ TextField(label, name, typ, value string, required bool, errs FormErrors, attrs templ.Attributes) {
	<div>
		@fieldLabel(name, label, required)
		<input
			id={ name }
			name={ name }
			type={ typ }
			value={ value }
			required?={ required }
			class={ inputClass, templ.KV("border-alert", errs[name] != "") }
			{ attrs... }
		/>
		@fieldError(errs[name])
	</div>
}

templ TextArea(label, name, value string, errs FormErrors) {
	<div>
		@fieldLabel(name, label, false)
		<textarea id={ name } name={ name } rows="2" class={ inputClass, templ.KV("border-alert", errs[name] != "") }>{ value }</textarea>
		@fieldError(errs[name])
	</div>
}

templ SelectField(label, name string, options []Option, selected string, errs FormErrors) {
	<div>
		@fieldLabel(name, label, false)
		<select id={ name } name={ name } class={ inputClass, templ.KV("border-alert", errs[name] != "") }>
			for _, o := range options {
				<option value={ o.Value } selected?={ o.Value == selected }>{ o.Label }</option>
			}
		</select>
		@fieldError(errs[name])
	</div>
}

// CredentialsModal shows a newly generated password exactly once.
templ CredentialsModal(title, name, email, password string) {
	@Modal(title) {
		<div class="space-y-3 text-sm">
			<p>Berikan data login ini kepada <strong>{ name }</strong>. Kata sandi hanya ditampilkan <strong>sekali</strong>.</p>
			<dl class="rounded-lg bg-gray-50 p-4">
				<dt class="text-xs text-gray-500">Email</dt>
				<dd class="font-semibold">{ email }</dd>
				<dt class="mt-2 text-xs text-gray-500">Kata sandi sementara</dt>
				<dd class="font-mono text-lg font-bold tracking-wider">{ password }</dd>
			</dl>
			<div class="flex justify-end">
				<button type="button" onclick="closeModal()" class="rounded-lg bg-brand px-5 py-2.5 text-sm font-semibold text-white">Selesai</button>
			</div>
		</div>
	}
}
