APP_ENV=development
PORT=8080

# Supabase / Neon / local Postgres. Use sslmode=require for hosted DBs.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/daycare?sslmode=disable

# Generate with: openssl rand -base64 48
JWT_SECRET=
SESSION_SECRET=
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=720h

# Defaults to true when APP_ENV=production
COOKIE_SECURE=false
