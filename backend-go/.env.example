APP_ENV=development
PORT=8080

# Supabase / Neon / local Postgres. Use sslmode=require for hosted DBs.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/daycare?sslmode=disable

# Required, min 32 chars. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=720h
# Admin web login session
SESSION_TTL=12h

# Defaults to true when APP_ENV=production
COOKIE_SECURE=false

# Daycare time zone: decides which calendar day attendance belongs to
DAYCARE_TIMEZONE=Asia/Jakarta
# Apply pending database migrations when the server starts
AUTO_MIGRATE=true

# Media storage (S3-compatible, e.g. Cloudflare R2). Leave empty to disable uploads.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_SSL=true

# Push notifications (Firebase). Path to the service-account JSON key, or
# paste the whole JSON into FCM_CREDENTIALS_JSON. Leave empty to disable.
FCM_CREDENTIALS_FILE=
FCM_CREDENTIALS_JSON=
